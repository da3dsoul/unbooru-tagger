<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\unbooru-tagger-core\unbooru-tagger-core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TagRowMutations and friends stay internal to this command-line app, but their
         pure logic is exactly what most needs direct unit testing. -->
    <InternalsVisibleTo Include="unbooru-tagger-tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UnbooruTagger.Crawler</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
